# Kenwer Channel 3 — local development defaults
# Copy to .env and adjust. Never commit real secrets.

APP_NAME=kenwer-c3
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (host port 5433 maps to container 5432 — see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://kenwer:kenwer@localhost:5433/kenwer_c3

# Redis / Celery (host port 6380 maps to container 6379)
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# MinIO (S3-compatible object storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=kenwerminio
S3_SECRET_KEY=kenwerminio
S3_BUCKET=kenwer-c3-evidence
S3_REGION=us-east-1

# Auth (dev only — replace in non-local environments)
DEV_API_KEYS=dev-admin-key:admin,dev-ingest-key:channel2_ingest,dev-retrieve-key:channel1_retrieve,dev-reviewer-key:reviewer
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_COGNITIVE_IDENTITY_ID=00000000-0000-4000-8000-000000000010

# LLM — leave unset to use MockReasoningProvider
LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Observability — Agent Beacon optional, disabled by default
OTEL_ENABLED=false
BEACON_ENABLED=false
# BEACON_OTLP_ENDPOINT=
